# Copie para .env (ignorado pelo git) e preencha.
# Valores do firebaseConfig: Console Firebase > Configurações do projeto > Seus apps > App Web.

# true = usa o Firebase Emulator Suite local (projeto demo, nunca toca em produção).
# Com true, os campos FIREBASE_* abaixo são ignorados.
USE_EMULATORS=true

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
