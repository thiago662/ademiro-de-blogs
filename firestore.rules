rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isGuest() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Auth permite criar conta via API mesmo sem tela de cadastro:
    // estar logado nunca basta, admin precisa estar na allowlist.
    function isAdmin() {
      return signedIn() && !isGuest()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Deny by default. Cada coleção ganha sua regra nas próximas fases.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
